# Налаштування локальної моделі та пошуку. Секрети й API-ключі не потрібні.

# Модель ембедінгів: ідентифікатор на Hugging Face Hub. Значення —
# відправна точка. Змінивши модель, перебудуйте індекс: вектори різних
# моделей непорівнянні.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Скільки результатів повертати за замовчуванням.
SEARCH_TOP_K=5

# Поріг схожості для семантичного пошуку: результати з меншою оцінкою
# відкидаються. Порожнє значення — без порога. Звідки взяти число —
# питання з розділу 2 практичної роботи; «з голови» воно не береться.
SIMILARITY_THRESHOLD=

# Параметри поділу на фрагменти. У чому їх рахувати і як застосовувати —
# ваше рішення; це лише спосіб не зашивати числа в код.
CHUNK_SIZE=600
CHUNK_OVERLAP=100
